{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trgovina",
  "compatibility_date": "2026-08-01",
  "main": "src/worker.ts",

  // Keep the *.workers.dev deployment alive — QA target and fallback URL,
  // same convention as fans-network and ocenagor-landing. With a `routes`
  // array present but no `workers_dev` key, Cloudflare infers `false` on the
  // next deploy and silently disables trgovina.worldfans.workers.dev.
  "workers_dev": true,

  // Public identifiers, not secrets — both are meant to ship to browsers.
  //
  // THE WORKER NEEDS NO SECRET TO RUN. It used to need three, then one; the
  // last of them, SUPABASE_SERVICE_KEY, went when the admin panel started
  // acting as the signed-in person rather than as the service role. Every
  // Supabase call now carries that person's own access token, and the database
  // decides what may happen — see the admin_acts_as_itself migration. A fresh
  // clone plus a deploy is a working shop and a working panel, and the
  // publishable key below can do only what this project's RLS allows an
  // anonymous visitor to do: read a live shop's published pages.
  //
  // ONE OPTIONAL SECRET, for one optional feature:
  //   GEMINI_API_KEY   Turns on the panel's alt-text writer and its 2K
  //                    upscaler. Absent, the panel writes stand-in
  //                    descriptions, uploads photographs at their original
  //                    size, and nothing else changes. See enhance.ts — it
  //                    REDRAWS a photograph rather than sharpening it, which
  //                    is why the panel says so when it has.
  //
  //   ⚠️ SET IT AS A GITHUB REPOSITORY SECRET, not in the Cloudflare
  //   dashboard. The deploy workflow puts it on the Worker with `wrangler
  //   secret put` on every run. Added in the dashboard as a plaintext
  //   VARIABLE it does not survive: `wrangler deploy` replaces the vars
  //   block below with exactly what this file declares, so the next deploy
  //   deletes it — silently, and the only symptom is a line of grey text in
  //   the admin panel saying automatic descriptions are off. That happened.
  //   A dashboard SECRET (the encrypted kind) does survive, but then the
  //   key's existence lives nowhere in this repository, and the deploy
  //   cannot re-establish it.
  //
  // Admin accounts are Supabase Auth users on the public.admins allowlist.
  // ⚠️ KEEP WHAT THE DASHBOARD HOLDS.
  //
  // Without this, `wrangler deploy` DELETES every runtime variable that is not
  // declared below before setting the ones that are. A key added in the
  // Cloudflare dashboard therefore survived until the next deploy and then
  // vanished — silently, because the feature it powers is optional and simply
  // switched itself off. That is a deploy pipeline quietly undoing the
  // operator's work, which is not a thing an operator should have to know
  // about, so the pipeline stops doing it.
  //
  // The cost is that this file is no longer the sole authority on vars: one
  // removed here stays on the Worker until it is removed in the dashboard too.
  // That is the right trade. The values below are public config; the one thing
  // that is NOT public is added in the dashboard, and it now stays there.
  "keep_vars": true,

  "vars": {
    "SUPABASE_URL": "https://cybwzhgretztcjfdefoy.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable__aHkVGGeNcPgiwyB7tS_Sw_WpVTbBYy",
    // Model names move faster than deploys; this moves the upscaler onto a new
    // one without touching enhance.ts. Public — it names a model, not a key.
    "GEMINI_IMAGE_MODEL": "gemini-3-pro-image-preview"
  },

  // GOING LIVE (per shop — the onlyworld staged pattern):
  //
  // 1. Register the domain FRESH, add the zone to THIS Cloudflare account,
  //    point the registrar at Cloudflare's nameservers, wait until Active.
  //    ⚠️ Never add a route for a zone that is not Active in this account:
  //    wrangler fails the whole deploy with error 10082, taking every live
  //    shop's deploy down with it.
  // 2. Uncomment the shop's pair below — both lines, www is not implied.
  // 3. Deploy. Pre-live shops serve 503 + noindex, so attaching early is
  //    safe and warms TLS.
  // 4. Zone Redirect Rule: 301 www.<domain>/* → https://<domain>/$1, and
  //    SSL/TLS → Always Use HTTPS. Deliberately not done in the worker.
  // 5. When launch gates pass: set live: true in src/tenants/<shop>.ts,
  //    is_live = true on the shops row, redeploy. GSC + Bing + sitemap.
  //
  // ONE SHOP. The other five domains that used to be listed here went with
  // their tenants — a route for a host the resolver does not know serves a
  // hard 404 at best, and at worst attaches a zone nobody owns.
  //
  // ⚠️ THE PAIR BELOW NOW NAMES THE SHOP'S OWN DOMAIN. It used to name
  // masazni-bazen.si — a domain this business DOES NOT OWN (it resolves to
  // 212.44.105.63, not Cloudflare) — so following the launch steps verbatim
  // would have attached somebody else's hostname. The tenant's domains are
  // masazni-bazeni-vrelec.si and masaznibazenivrelec.si (src/tenants/bazen.ts),
  // and those are the only patterns that may ever be uncommented here.
  //
  // Do NOT uncomment until that zone reads Active in THIS account: step 1
  // above is not paperwork, it is the difference between a working deploy
  // and error 10082 taking the whole deploy down.
  //
  // ⚠️ ALL FOUR PATTERNS, NOT JUST THE CANONICAL PAIR. The worker answers
  // www and the alias domain with a 301 to the canonical origin — but only
  // for requests that reach it, and a hostname with no route here never
  // does. A registered domain left unrouted is a domain that resolves to
  // Cloudflare and returns an error page, which is worse for the brand than
  // not owning it. Each alias needs its own zone Active in this account,
  // exactly like the canonical one.
  //
  // WHICH DOMAIN IS CANONICAL is decided in src/tenants/bazen.ts, not here:
  // this list is every host the worker must be reachable on, in either
  // direction. Swapping the canonical needs no change to this block.
  //
  // "routes": [
  //   { "pattern": "masazni-bazeni-vrelec.si", "custom_domain": true },
  //   { "pattern": "www.masazni-bazeni-vrelec.si", "custom_domain": true },
  //   { "pattern": "masaznibazenivrelec.si", "custom_domain": true },
  //   { "pattern": "www.masaznibazenivrelec.si", "custom_domain": true }
  // ],

  // Static assets, served from the edge before the Worker runs. Only /img/*
  // lives here; every page is still server-rendered by src/worker.ts.
  //
  // Note the ordering consequence: an asset is served for ANY Host, including
  // one the tenant resolver would 404. That is fine for imagery — it leaks no
  // canonical and names no shop — but it is the reason nothing HTML-shaped may
  // ever be put in this directory.
  "assets": {
    "directory": "./public"
  },

  "observability": {
    "enabled": true
  }
}
