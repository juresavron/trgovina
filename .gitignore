node_modules/
dist/
.env
.wrangler/

# Transient measurement harnesses and their before/after captures.
#
# ⚠️ ANCHORED TO THE REPO ROOT, and matched by EXTENSION rather than by name.
#
# They land at the root and not by choice: playwright-core only resolves from
# there, so a harness written into scripts/ cannot import it. The rule this
# replaces was scripts/.tmp-*.mjs, which therefore never matched one of them.
# Naming them individually did not work either — every audit invents its own
# spelling (measure.mjs, pdp-measure.mjs, shoot-sections.mjs, sec-before-*.png)
# and the list was already stale by the time it was written.
#
# Safe because the root holds no tracked file of either kind: it carries seven
# files, all of them config or documentation (git ls-files, no slash). The
# leading slash keeps this off scripts/*.mjs and public/*.png, both shipped.
/*.mjs
/*.png
/*.json
/*.log
/shots/
!/package.json
!/package-lock.json
!/tsconfig.json

# Claude Code session tooling — agent worktrees live here during a session
# and hold deliberately uncommittable rehearsal state (e.g. a local live:true
# flip with stand-in identity values). Never repository content.
/.claude/

# Scratch harnesses. Audits in this repo are written as throwaway scripts that
# bundle the worker, serve it and drive Chromium — and two of them were swept
# into a commit by `git add -A` while they were still being written. Anything
# a probe needs lives in scripts/audit-*.mjs once it earns a name.
scripts/_*.mjs
